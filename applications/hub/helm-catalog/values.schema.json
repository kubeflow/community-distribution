{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario",
    "database"
  ],
  "properties": {
    "scenario": {
      "type": "string",
      "enum": [
        "platform"
      ]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "type": "string"
        }
      }
    },
    "huggingFaceApiKey": {
      "type": "string"
    }
  }
}
